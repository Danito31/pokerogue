{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "rm -rf assets/* 2>/dev/null; git submodule update --init --depth 1 locales 2>/dev/null; pnpm install --frozen-lockfile",
  "buildCommand": "VITE_BYPASS_LOGIN=1 pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/images/:path*", "destination": "https://pokerogue.net/images/:path*" },
    { "source": "/audio/:path*", "destination": "https://pokerogue.net/audio/:path*" },
    { "source": "/fonts/:path*", "destination": "https://pokerogue.net/fonts/:path*" },
    { "source": "/manifest.webmanifest", "destination": "https://pokerogue.net/manifest.webmanifest" },
    { "source": "/logo512.png", "destination": "https://pokerogue.net/logo512.png" },
    { "source": "/logo192.png", "destination": "https://pokerogue.net/logo192.png" }
  ]
}
